  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "@zip.js/zip.js": "2.18.2",
    "fzstd": "0.1.1",
    "hash-wasm": "4.12.0",
    "pako": "3.0.2",
    "seek-bzip": "2.0.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright-core": "1.63.0"
  }

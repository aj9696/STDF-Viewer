    "build:storage": "node scripts/build-storage.mjs",
    "build:vendor": "node scripts/build-vendor.mjs",
    "package:pages": "node scripts/package-pages.mjs",
    "test:compression": "node scripts/compression-check.mjs",
    "test:storage": "node scripts/storage-check.mjs",
    "test:library:metadata": "node scripts/library-metadata-unit.mjs && node scripts/library-metadata-check.mjs",
    "test:library:organize": "node scripts/library-organize-check.mjs && node scripts/library-organize-ui-check.mjs",
    "test:viewer:report-filter": "node scripts/viewer-report-filter-check.mjs",
    "test:viewer:report-filter-ui": "node scripts/viewer-report-filter-ui-check.mjs",
    "test:viewer:model": "node scripts/viewer-model-check.mjs",
    "test:viewer": "node scripts/viewer-check.mjs",
    "test:viewer:ui": "node scripts/viewer-ui-check.mjs",
    "test:viewer:e2e": "node scripts/viewer-e2e-check.mjs",
    "test:viewer:transfer": "node scripts/viewer-transfer-check.mjs",
    "test:viewer:population": "node scripts/viewer-population-check.mjs",
    "test:studies": "node scripts/viewer-studies-check.mjs",
    "test:tools": "node scripts/viewer-tools-ui-check.mjs",
    "test:wafer-studies": "node scripts/wafer-studies-check.mjs",
    "test:authoring": "node scripts/authoring-check.mjs",
    "test:documents": "node scripts/viewer-documents-check.mjs",
    "test:reclassification": "node scripts/reclassification-check.mjs",
    "test:authoring:ui": "node scripts/authoring-ui-check.mjs",
    "test:pat-lots": "node scripts/viewer-pat-recipes-check.mjs",
    "test:preferences": "node scripts/viewer-preferences-check.mjs",
    "test:preferences:ui": "node scripts/viewer-preferences-browser-check.mjs",
    "test:localization": "node scripts/viewer-localization-check.mjs",
    "test:study-charts": "node scripts/viewer-study-charts-check.mjs",
    "test:wafer-studies:browser": "node scripts/wafer-studies-browser-check.mjs",
    "test:viewer:summaries": "node scripts/viewer-summaries-check.mjs",
    "test:viewer:summary-model": "node scripts/viewer-summary-model-check.mjs",
    "test:viewer:help": "node scripts/viewer-help-check.mjs",
    "test:viewer:yield": "node scripts/viewer-yield-check.mjs",
    "test:viewer:yield-model": "node scripts/viewer-yield-model-check.mjs",
    "test:viewer:yield-ui": "node scripts/viewer-yield-ui-check.mjs"
